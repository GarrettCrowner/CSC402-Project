# ── Python Flask Backend ──────────────────────────────────────────────────────
# Uses a slim Python 3.11 base to keep the image small.

FROM python:3.11-slim

# Install curl (needed for MinIO healthcheck in some environments)
RUN apt-get update && apt-get install -y --no-install-recommends curl && rm -rf /var/lib/apt/lists/*

# Set working directory inside the container
WORKDIR /app

# Copy and install dependencies first (leverages Docker layer caching)
COPY backend/requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Copy application code
COPY backend/chatbot_api.py .
COPY backend/qdrant_setup.py .

# Expose the port Flask runs on
EXPOSE 5001

# Start the Flask service
CMD ["python", "chatbot_api.py"]
